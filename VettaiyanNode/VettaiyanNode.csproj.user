<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebuggerFlavor>ProjectDebugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup>
    <ActiveDebugProfile>VettaiyanNode (Package)</ActiveDebugProfile>
    <Source>Assets\VettaiyanLogo.png</Source>
    <SmallTileSource>Assets\VettaiyanLogo.png</SmallTileSource>
    <MediumTileSource>Assets\VettaiyanLogo.png</MediumTileSource>
    <WideTileSource>Assets\VettaiyanLogo.png</WideTileSource>
    <LargeTileSource>Assets\VettaiyanLogo.png</LargeTileSource>
    <AppIconSource>Assets\VettaiyanLogo.png</AppIconSource>
    <SplashScreenSource>Assets\VettaiyanLogo.png</SplashScreenSource>
    <PackageLogoSource>Assets\VettaiyanLogo.png</PackageLogoSource>
  </PropertyGroup>
  <ItemGroup>
    <None Update="App.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Update="MainWindow.xaml">
      <SubType>Designer</SubType>
    </None>
    <Page Update="Pages\ThreatDetails.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Pages\Settings.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Pages\Dashboard.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Pages\Scan.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Pages\Threats.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="AppResources.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>