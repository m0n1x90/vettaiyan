<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VettaiyanNode.Pages.ThreatDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VettaiyanNode.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer
        x:Name="ThreatPageViewer"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">

            <!-- Page Header -->
            <StackPanel
                Padding="0,0,0,16">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    Padding="0,0,0,8">
                    <FontIcon
                        Glyph="&#xE81B;"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Text="Threat Details"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontWeight="Normal"
                        VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock
                    Text="View detailed information about the detected threats"
                    Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <StackPanel
                Spacing="16"
                Padding="6">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <FontIcon Glyph="&#xF000;"/>
                    <TextBlock Text="File Name:"/>
                    <TextBlock Text="{x:Bind Threat.ThreatImageName}"
                               Foreground="SlateGray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <FontIcon Glyph="&#xE730;"/>
                    <TextBlock Text="Detected Rule Name:"/>
                    <TextBlock Text="{x:Bind Threat.ThreatName}"
                               Foreground="SlateGray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE773;"/>
                    <TextBlock Text="Location:"/>
                    <TextBlock Text="{x:Bind Threat.ThreatImagePath}"
                               Foreground="SlateGray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xEE93;"/>
                    <TextBlock Text="Detected At:"/>
                    <TextBlock Text="{x:Bind Threat.TimeDetected}"
                               Foreground="SlateGray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE7BC;"/>
                    <TextBlock Text="SHA256 Hash:"/>
                    <TextBlock Text="{x:Bind Threat.ThreatImageHash}"
                               Foreground="SlateGray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE7B8;"/>
                    <TextBlock Text="File Type:"/>
                    <TextBlock Text="{x:Bind Threat.ThreatImageType}"
                               Foreground="SlateGray"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xEA18;"/>
                    <TextBlock Text="Action Taken:"/>
                    <TextBlock Text="{x:Bind Threat.ActionTaken}"
                               Foreground="SlateGray"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
