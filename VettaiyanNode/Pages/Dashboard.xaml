<Page
    x:Class="VettaiyanNode.Pages.Dashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VettaiyanNode.Pages"
    xmlns:model="using:VettaiyanNode.Model"
>

    <ScrollViewer>
        <StackPanel Spacing="6">

            <!-- Page Header -->
            <StackPanel
                Padding="0,0,0,16"    
            >
                <StackPanel 
                    Orientation="Horizontal" 
                    Spacing="12" 
                    VerticalAlignment="Center"
                    Padding="0,0,0,8"
                >
                    <FontIcon 
                        Glyph="&#xE80F;" 
                        VerticalAlignment="Center"
                    />
                    <TextBlock 
                        Text="Dashboard"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontWeight="Normal"
                        VerticalAlignment="Center"
                    />
                </StackPanel>
                <TextBlock 
                    Text="Overview of endpoint status and recent threats"
                    Style="{StaticResource BodyTextBlockStyle}"
                />
            </StackPanel>

            <!-- Dashboard Grid Layout -->
            <Grid 
                RowSpacing="16" 
                ColumnSpacing="32"
            >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- Endpoint MetaInfo Block -->
                <Border 
                    Grid.Row="0" 
                    Grid.Column="0"
                    CornerRadius="8"
                    Padding="0,0,0,20"
                >
                    <StackPanel 
                        Spacing="10"
                        Orientation="Vertical"
                    >
                        <TextBlock 
                            Text="Endpoint Metadata"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Padding="0,0,0,8"
                        />
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Endpoint :"/>
                            <TextBlock x:Name="EndpointText"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="OS :"/>
                            <TextBlock x:Name="OSText"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="User :"/>
                            <TextBlock x:Name="UserText"/>
                        </StackPanel>
                    
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Last Sync :"/>
                            <TextBlock x:Name="SyncText"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Agent Statistics Block -->
                <Border 
                    Grid.Row="0" 
                    Grid.Column="1"
                    CornerRadius="8"
                    Padding="0,0,0,20"
                >
                    <StackPanel
                        Spacing="10"
                        Orientation="Vertical"
                    >
                        <TextBlock 
                            Text="Agent Statistics"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Padding="0,0,0,8"
                        />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Last Scan:"/>
                            <TextBlock x:Name="LastScanText"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Threats Detected :"/>
                            <TextBlock x:Name="ThreatsBlockedText"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Agent Status :"/>
                            <TextBlock x:Name="AgentStatusText"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Real Time Protection:"/>
                            <TextBlock x:Name="RealTimeProtectionText"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Threat Summary Table -->
                <Border 
                    Grid.Row="1" 
                    Grid.ColumnSpan="2"
                >
                    <StackPanel
                        Spacing="10"
                        Orientation="Vertical"
                    >
                        <TextBlock 
                            Text="Recent Threats"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Padding="0,0,0,8"
                        />

                        <Grid ColumnSpacing="16" CornerRadius="4" Padding="16,8,16,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Threat Name" FontWeight="Bold" Grid.Column="0" />
                            <TextBlock Text="Detected On" FontWeight="Bold" Grid.Column="1" />
                            <TextBlock Text="Time Detected" FontWeight="Bold" Grid.Column="2" />
                            <TextBlock Text="Action Taken" FontWeight="Bold" Grid.Column="3" />
                        </Grid>

                        <!-- Threat Data Rows -->
                        <ItemsControl 
                            x:Name="ThreatListView"
                            ItemsSource="{x:Bind Threats, Mode=OneWay}"
                        >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:Threat">
                                    <Border
                                        x:Name="RowBorder"
                                        CornerRadius="4"
                                        Margin="0,0,0,6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                    >

                                        <Grid
                                            x:Name="RowGrid"
                                            ColumnSpacing="16"
                                            Padding="16,8"
                                        >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Bind ThreatName}" Grid.Column="0" />
                                            <TextBlock Text="{x:Bind ThreatImageName}" Grid.Column="1" />
                                            <TextBlock Text="{x:Bind TimeDetected}" Grid.Column="2" Foreground="DimGray"/>
                                            <TextBlock Text="{x:Bind ActionTaken}" Grid.Column="3" Foreground="DarkGreen"/>
                                        </Grid>

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <StackPanel 
                            x:Name="NoThreatsBanner"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="10"
                            Spacing="10"
                        >
                            <Image 
                                Source="/Assets/Images/Secure.png" 
                                Width="64" 
                                Height="64" 
                                Stretch="Uniform"
                            />
                            <TextBlock 
                                Text="✅ No threats detected."
                                FontSize="16"
                                Foreground="DarkGreen"
                                HorizontalAlignment="Center"
                            />      
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
